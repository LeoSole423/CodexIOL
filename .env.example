IOL_USERNAME=
IOL_PASSWORD=
IOL_API_URL=https://api.invertironline.com
IOL_TIMEOUT=20

# Used only to estimate an order summary before execution.
IOL_COMMISSION_RATE=0.0
IOL_COMMISSION_MIN=0.0

# Prepared order tickets. Keep this directory private and outside Git.
IOL_STATE_DIR=data/cli-state
IOL_TICKET_TTL_MINUTES=30

# Read-only MCP server. Docker publishes it only on localhost by default.
IOL_MCP_PORT=8000
IOL_MCP_TRANSPORT=streamable-http
