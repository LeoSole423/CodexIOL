IOL_USERNAME=
IOL_PASSWORD=
IOL_API_URL=https://api.invertironline.com
IOL_TIMEOUT=20
IOL_COMMISSION_RATE=0.006   # 0.6% por punta (IOL estándar) — total 1.2% ida+vuelta
IOL_COMMISSION_MIN=0.0      # Comisión mínima por operación en ARS (0 = sin mínimo)
IOL_SIM_COMMISSION_TIER=gold # gold=0.50%, platinum=0.30%, black=0.10% según tarifario IOL Argentina
IOL_SIM_INCLUDE_IVA=1
IOL_SIM_INCLUDE_MARKET_FEES=1
IOL_SIM_DEFAULT_INSTRUMENT_TYPE=stock
IOL_SIM_INSTRUMENT_OVERRIDES=
IOL_SIM_MAX_DAILY_VOLUME_PCT=0.02
IOL_DB_PATH=data/iol_history.db
IOL_MARKET_TZ=America/Argentina/Buenos_Aires
IOL_MARKET_OPEN_TIME=11:00
IOL_MARKET_CLOSE_TIME=18:00
IOL_SNAPSHOT_INTERVAL_MIN=5
IOL_ORDERS_LOOKBACK_DAYS=400
IOL_ORDERS_SYNC_OVERLAP_DAYS=7
IOL_STORE_RAW=0
IOL_SEC_CONTACT_EMAIL=
# Optional override, example:
# IOL_SEC_USER_AGENT=CodexIOL/1.0 (tu-email@dominio.com)
IOL_SEC_USER_AGENT=

# Opportunity engine watchlist: symbols always evaluated regardless of IOL panel
# Format: SYMBOL:market comma-separated. Market defaults to bcba if omitted.
# Example: IOL_OPP_WATCHLIST=ETSY:bcba,COIN:bcba,MELI:bcba
IOL_OPP_WATCHLIST=
